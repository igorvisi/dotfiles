[global]
    monitor = 0
    follow = mouse
    width = 380
    height = (0, 180)
    origin = top-right
    offset = (5, 36)
    notification_limit = 10
    gap_size = 8
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#61AFEF"
    separator_height = 1
    separator_color = "#3E4451"
    corner_radius = 0
    font = Maple Mono 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    min_icon_size = 40
    max_icon_size = 40
    sort = yes
    idle_threshold = 120
    timeout = 8
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_current

[urgency_low]
    background = "#1E2229"
    foreground = "#ABB2BF"
    frame_color = "#5C6370"
    timeout = 5

[urgency_normal]
    background = "#1E2229"
    foreground = "#ABB2BF"
    frame_color = "#61AFEF"
    timeout = 8

[urgency_critical]
    background = "#1E2229"
    foreground = "#E06C75"
    frame_color = "#E06C75"
    timeout = 0
