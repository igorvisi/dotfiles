[alias]
	a = add --all
	u = pull
	p = push
	co = checkout
	s = status -s
	pf = push -f
	sclone = clone --depth=1
	unstage = reset HEAD --
	undopush = push -f origin HEAD^:main
	last = log -1 HEAD
	deleted = !git ls-files --deleted

[core]
	excludesfile = ~/.gitignore
	fileMode = false
	pager = delta

[delta]
	light = false

[pager]
	diff = delta

[push]
	default = current

[status]
	submoduleSummary = true
[init]
	defaultBranch = main
[commit]
	gpgsign = true

[gpg]
	format = ssh

[include]
	# include my personal and business conf from ~/.gitconfig.local
	path = ~/.gitconfig.local
